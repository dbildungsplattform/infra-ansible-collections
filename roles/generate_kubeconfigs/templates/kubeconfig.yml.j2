{# Ensure that the values registered in a loop didn't get mixed up #}
{% if _serviceaccount_token.result.metadata.annotations['kubernetes.io/service-account.name'] == _serviceaccount_name %}
apiVersion: v1
kind: Config
preferences: {}
current-context: {{ _serviceaccount_name }}@{{ generate_kubeconfigs_cluster_name }}
clusters:
- cluster:
{% if generate_kubeconfigs_proxy_domain %}
    proxy-url: https://{{ _proxy_user }}:{{ _proxy_pass }}@{{ generate_kubeconfigs_proxy_domain }}:{{ generate_kubeconfigs_proxy_port }}
{% endif %}
    certificate-authority-data: {{ _cacerts | b64encode }}
    server: {{ _kubeconfig_yaml.clusters[0].cluster.server }}
  name: !!str {{ generate_kubeconfigs_cluster_name }}
contexts:
- context:
    cluster: !!str {{ generate_kubeconfigs_cluster_name }}
    user: {{ _serviceaccount_name }}
  name: {{ _serviceaccount_name }}@{{ generate_kubeconfigs_cluster_name }}
users:
- name: {{ _serviceaccount_name }}
  user:
    token: {{ _serviceaccount_token.result.data.token | b64decode }}
{% endif %}
